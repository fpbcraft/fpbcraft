	quest.6AC099F5F9A76F74.title: "Obtain Deathmantle Armor Head"
	quest.6AD9C77E76186397.quest_desc: [
		"The &cKinetic Battery&r stores &6Stress Units&r for later use. This way it allows you to have a source of a limited amount of &6Stress Units&r whenever necessary without the need for a new setup each time. But to use this block for your needs first you will need to &ccharge&r it"
		""
		"The &cKinetic Battery&r charges itself by consuming &6SU&r from the grid it is connected to whenever it &l&4is not&r powered on, and uses that charge to provide &6SU&r to the connected grid whenever &2&lit is&r powered on "
	]
	quest.6AD9C77E76186397.title: "&5How to charge the Kinetic Battery"
	quest.6B0D4D68E811EE9D.quest_desc: [
		"&6Sophisticated Backpacks&r add some of the most useful Backpacks to Minecraft!"
		""
		"To equip a &9backpack&r, click the Equip icon in the &9backpack&r menu."
		""
		"Once a &9backpack&r is equipped, you can open it by pressing &bB&r"
		""
		"&9Backpacks&r can be upgraded through several tiers."
		""
		"To see all &9backpack&r variants, search &d@sophisticated&r in the &eEMI&r search bar."
		""
		"You can find this search bar at the bottom right. "
		""
		"Clicking on items in the item list to the right of your inventory will show their recipes and uses."
		""
		"You can also press &bR&r and &bU&r while hovering over any item to see their Recipe and Uses"
	]
	quest.6B0D4D68E811EE9D.title: "Portable Inventory"
	quest.6B0F9EBA06D1C843.quest_desc: ["There are 3 main ways of getting &2Nuggets of Experiences&r: &6Crushing Wheels&r, &bdropped by slain Mobs&r or &dBottles of Experience&r."]
