	quest.41374A60BC001BEE.quest_subtitle: "To make some peats"
	quest.41374A60BC001BEE.title: "&eObtain Materials"
	quest.4BCFB8B54450D011.quest_desc: ["Obtained by &cBlasting&r or &cBulk-Blasting&r a piece of Coal"]
	quest.4BCFB8B54450D011.quest_subtitle: "Decent upgrade to the boring coal"
	quest.4BCFB8B54450D011.title: "&eCoal Coke"
	quest.5071FAFF85324148.quest_subtitle: "Can be used as building blocks or turned into &aPeat Briquettes "
	quest.5071FAFF85324148.title: "&dPeat"
	quest.50AC5D9635367390.quest_desc: ["Crafted with the help of 11 &6Mechanical Crafters&r this item is the first step towards renewable &4blaze fuels&r"]
	quest.50AC5D9635367390.quest_subtitle: "Now time to fuel it"
	quest.50AC5D9635367390.title: "&2Inactive Blaze Core"
	quest.5B1153E41E67209F.quest_desc: ["For our last step we will use a &6Spout filled with lava&r and fill up our &cBlaze core&r that's dropped onto a Depot underneath the Spout."]
