	quest.578B001354F83B31.title: "Stack Upgrade Omega Tier"
	quest.579F5AEF2EBE9A77.quest_desc: [
		"Powered through a &6Shaft&r from below, it will only rotate by a configured amount before stopping"
		""
		"When no rotational power is provided, the &6Torsion Spring&r will return to its initial rotation"
	]
	quest.579F5AEF2EBE9A77.title: "Torsion Spring"
