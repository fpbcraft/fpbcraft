	quest.50967C581A5DCDED.quest_desc: [
		"Can be found naturally in birch forests. The&e honey golem&r will shoot mobs with a honey projectile, which applies slowness."
		""
		"&eThe honey golem&r can function as a bee hive, and will contain bees which both defend, and heal the honey golem."
		""
		"These bees will also produce honey, which can be harvested from the golem for honey blobs."
		"Honey blobs are throwable items that function the same as the honey golems projectile."
	]
	quest.50967C581A5DCDED.title: "Honey golem"
	quest.5099E8991CA4485B.quest_desc: [
		"&7Andesite&r is a very abundant stone that you can find in large pockets underground. They blend really well with the stone texture, so keep your eyes open for them"
		""
		"&6Casings&r can be crafted by right clicking with a valid alloy or ingot on any stripped variant of log or wood"
	]
	quest.5099E8991CA4485B.title: "&7Andesite&r, the Foundation"
