	quest.55B9C9B22C1A3D3D.title: "Obtain Affix Augmentor"
	quest.55DC568DD6BDDBF6.quest_desc: [
		"{image:fpbcraft_quests:textures/end_03af14862e366ee0.png width:150 height:60 align:center}"
		""
		"&eThe kelp golem&r moves fastest in water."
		""
		"When within range of a conduit, the&e kelp golem&r will switch to its charged state and receive +100% strength, gradual regeneration, and +100% resistance until out of range of the conduit."
	]
	quest.55DC568DD6BDDBF6.title: "Kelp golem"
	quest.55EA0119442CF333.quest_desc: ["The &6iron backpack&r is the upgrade of the basic &ebackpack&r. It has 54 slots and can hold 2 upgrades"]
